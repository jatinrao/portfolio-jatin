# The Sanity CLI loads env files by mode (via Vite's loadEnv, same as
# frontend's Next.js): `sanity dev`/`start` use "development", `sanity
# build`/`deploy` use "production". Put values that differ between local
# dev and the deployed Studio in .env.development / .env.production, NOT
# here — putting a production URL in the shared .env (this file's real
# counterpart) makes `sanity dev` load it too and break local preview.
# See .env.development.example / .env.production.example for what goes
# in each.

SANITY_STUDIO_PROJECT_ID="<paste your project ID here>" # Required - The ID of your Sanity project
SANITY_STUDIO_DATASET="production" # Required - The dataset of your Sanity project
SANITY_STUDIO_SITE_AUTHOR_SLUG="" # Required - slug of the person document that is the site's canonical author (must match SITE_AUTHOR_SLUG in frontend/.env.local)
