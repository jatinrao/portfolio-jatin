# Loaded only by `sanity dev`/`sanity start` — see .env.example for why
# these live here instead of the shared .env.

SANITY_STUDIO_PREVIEW_URL="http://localhost:3000" #Optional - defaults to http://localhost:3000, only needs setting if your frontend dev server runs on a different port
SANITY_STUDIO_TRANSLATE_API_URL="http://localhost:3000/api/translate" #Optional - your local frontend's /api/translate endpoint
