# Loaded only by `sanity build`/`sanity deploy` — see .env.example for why
# these live here instead of the shared .env. Set these before running
# `npm run deploy` (from studio/), since the Studio is a static Vite app —
# these values get baked into the deployed bundle at build time, they are
# NOT read at runtime by the hosted Studio.

SANITY_STUDIO_PREVIEW_URL="" # Required for Presentation Tool in production — your deployed frontend's origin, e.g. https://test.getresume.dev
SANITY_STUDIO_STUDIO_HOST="" # Required to deploy — the hostname slug for Sanity's free hosting, e.g. "jatin-kumar" for https://jatin-kumar.sanity.studio
SANITY_STUDIO_TRANSLATE_API_URL="" #Optional - your deployed frontend's /api/translate endpoint, e.g. https://test.getresume.dev/api/translate
