{
  "name": "frontend",
  "private": true,
  "scripts": {
    "prebuild": "sanity typegen generate",
    "build": "next build",
    "predev": "npm run sanity:typegen",
    "dev": "next dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "sanity:typegen": "cd ../studio && sanity schema extract --enforce-required-fields --path ../sanity.schema.json && cd ../frontend && sanity typegen generate",
    "start": "next start",
    "type-check": "next typegen && tsc --noEmit",
    "typegen": "sanity typegen generate",
    "build:cf-static": "NEXT_PUBLIC_DEPLOY_TARGET=cloudflare next build && NODE_OPTIONS=\"--require $(pwd)/scripts/mock-server-only.cjs\" npx tsx --env-file-if-exists=.env.local scripts/extract-static-for-cloudflare.ts",
    "clean:cf": "rm -rf .next cf-static",
    "deploy:cf": "npm run clean:cf && npx playwright install chromium && npm run build:cf-static && wrangler pages deploy cf-static --project-name=jatin-portfolio",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:storybook": "vitest run --project storybook",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.5",
    "@sanity/client": "^7.22.1",
    "@sanity/image-url": "^2.1.1",
    "@sanity/uuid": "^3.0.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@vercel/speed-insights": "^2.0.0",
    "@web-portfolio/icons": "^1.0.3",
    "autoprefixer": "^10.5.0",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.32.0",
    "next": "^16.2.7",
    "next-sanity": "^13.0.8",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.15",
    "postprocessing": "^6.39.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sanity": "^5.28.0",
    "sanity-image": "^1.1.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.0",
    "three": "^0.185.1",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/addon-mcp": "latest",
    "@storybook/addon-vitest": "^10.5.8",
    "@storybook/nextjs-vite": "^10.5.8",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.7",
    "eslint-plugin-storybook": "^10.5.8",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "storybook": "^10.5.8",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "^4.110.0"
  }
}
